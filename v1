local function makeRow(parent, text, order, isToggle, default, onClick)
	local btn = Instance.new("TextButton")
	btn.Name = "Row_" .. order
	btn.Size = UDim2.new(1, 0, 0, 38)
	btn.BackgroundColor3 = isToggle and default and C_ITEM_ACT or C_ITEM
	btn.BackgroundTransparency = isToggle and default and 0.15 or 0.4
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Font = Enum.Font.GothamMedium
	btn.Text = "  " .. text .. (isToggle and ("    [" .. (default and "开" or "关") .. "]") or "")
	btn.TextSize = 14
	btn.TextColor3 = C_TXT
	btn.TextTransparency = 0.1
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.LayoutOrder = order
	btn.ZIndex = 6
	btn.Parent = parent

	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = btn
	local s = Instance.new("UIStroke"); s.Thickness = 1; s.Transparency = 0.75; s.Color = C_STROKE; s.Parent = btn

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C_ITEM_HOVER, BackgroundTransparency = 0.25 }):Play()
	end)
	btn.MouseLeave:Connect(function()
		if not isToggle or not btn:GetAttribute("On") then
			TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C_ITEM, BackgroundTransparency = 0.4 }):Play()
		else
			TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C_ITEM_ACT, BackgroundTransparency = 0.15 }):Play()
		end
	end)

	if isToggle then
		btn:SetAttribute("On", default)
		btn.MouseButton1Click:Connect(function()
			local on = not btn:GetAttribute("On")
			btn:SetAttribute("On", on)
			btn.Text = "  " .. text .. "    [" .. (on and "开" or "关") .. "]"
			TweenService:Create(btn, TweenInfo.new(0.15), {
				BackgroundColor3 = on and C_ITEM_ACT or C_ITEM,
				BackgroundTransparency = on and 0.15 or 0.4,
			}):Play()
			if onClick then onClick(on) end
		end)
	else
		if onClick then btn.MouseButton1Click:Connect(onClick) end
	end
	return btn
end

