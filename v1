local function buildGradient(hueShift, sat, val)
    local stops = {0.00, 0.45, 0.75, 1.00}
    local baseH = {0.50, 0.70, 0.90, 0.12}
    local keys = {}
    for i, s in ipairs(stops) do
        local h = (baseH[i] + hueShift) % 1
        keys[i] = ColorSequenceKeypoint.new(s, Color3.fromHSV(h, sat, val))
    end
    return ColorSequence.new(keys)
end

