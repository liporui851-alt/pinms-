	TweenService:Create(item, TweenInfo.new(0.18), { BackgroundColor3 = C_ITEM_ACT, BackgroundTransparency = 0.15, TextColor3 = C_TXT, TextTransparency = 0 }):Play()
	local s = item:FindFirstChildOfClass("UIStroke"); if s then TweenService:Create(s, TweenInfo.new(0.18), { Transparency = 0.45 }):Play() end
