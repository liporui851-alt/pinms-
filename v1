local function makeToggle(text, order, default, onChanged)
    local row = Instance.new("TextButton")
    row.Size = UDim2.new(1, 0, 0, 40)
    row.BackgroundColor3 = C_ITEM; row.BackgroundTransparency = 0.4
    row.BorderSizePixel = 0; row.AutoButtonColor = false
    row.Text = ""; row.LayoutOrder = order; row.ZIndex = 6; row.Parent = infoScroll
    local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(0, 8); rc.Parent = row
    local rs = Instance.new("UIStroke"); rs.Thickness = 1; rs.Transparency = 0.75; rs.Color = C_STROKE; rs.Parent = row
    local label = Instance.new("TextLabel")
    label.Position = UDim2.new(0, 12, 0, 0); label.Size = UDim2.new(1, -66, 1, 0)
    label.BackgroundTransparency = 1; label.Font = Enum.Font.GothamMedium
    label.Text = text; label.TextSize = 14; label.TextColor3 = C_TXT
    label.TextTransparency = 0.1; label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 7; label.Parent = row
    local switch = Instance.new("Frame")
    switch.AnchorPoint = Vector2.new(1, 0.5); switch.Position = UDim2.new(1, -12, 0.5, 0)
    switch.Size = UDim2.new(0, 36, 0, 20); switch.BackgroundColor3 = C_SWITCH_OFF
    switch.BorderSizePixel = 0; switch.ZIndex = 7; switch.Parent = row
    local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(1, 0); sc.Parent = switch
    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0, 0.5); knob.Position = UDim2.new(0, 2, 0.5, 0)
    knob.Size = UDim2.new(0, 16, 0, 16); knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
    knob.BorderSizePixel = 0; knob.ZIndex = 8; knob.Parent = switch
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob
    local function setState(on, animate)
        local tInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local targetKnobPos = on and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        local targetColor = on and C_ACCENT or C_SWITCH_OFF
        if animate then
            TweenService:Create(switch, tInfo, { BackgroundColor3 = targetColor }):Play()
            TweenService:Create(knob, tInfo, { Position = targetKnobPos }):Play()
        else
            switch.BackgroundColor3 = targetColor
            knob.Position = targetKnobPos
        end
    end
    setState(default, false); row:SetAttribute("On", default)
    row.MouseEnter:Connect(function() TweenService:Create(row, TweenInfo.new(0.15), { BackgroundTransparency = 0.25 }):Play() end)
    row.MouseLeave:Connect(function() TweenService:Create(row, TweenInfo.new(0.15), { BackgroundTransparency = 0.4 }):Play() end)
    row.MouseButton1Click:Connect(function()
        local on = not row:GetAttribute("On")
        row:SetAttribute("On", on); setState(on, true)
        if onChanged then onChanged(on) end
    end)
    return row
end

local function makeSlider(text, order, minV, maxV, default, step, onChanged)
    local wrap = Instance.new("Frame")
    wrap.Name = "SliderWrap"; wrap.Size = UDim2.new(1, 0, 0, 54)
    wrap.BackgroundColor3 = C_ITEM; wrap.BackgroundTransparency = 0.4
    wrap.BorderSizePixel = 0; wrap.LayoutOrder = order; wrap.ZIndex = 6; wrap.Parent = infoScroll
    local wc = Instance.new("UICorner"); wc.CornerRadius = UDim.new(0, 8); wc.Parent = wrap
    local ws = Instance.new("UIStroke"); ws.Thickness = 1; ws.Transparency = 0.75; ws.Color = C_STROKE; ws.Parent = wrap
    local label = Instance.new("TextLabel")
    label.Position = UDim2.new(0, 12, 0, 6); label.Size = UDim2.new(1, -90, 0, 18)
    label.BackgroundTransparency = 1; label.Font = Enum.Font.GothamMedium
    label.Text = text; label.TextSize = 13; label.TextColor3 = C_TXT
    label.TextTransparency = 0.1; label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 7; label.Parent = wrap
    local valueLbl = Instance.new("TextLabel")
    valueLbl.AnchorPoint = Vector2.new(1, 0); valueLbl.Position = UDim2.new(1, -12, 0, 6)
    valueLbl.Size = UDim2.new(0, 70, 0, 18); valueLbl.BackgroundTransparency = 1
    valueLbl.Font = Enum.Font.GothamBold; valueLbl.TextSize = 13
    valueLbl.TextColor3 = C_ACCENT; valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.ZIndex = 7; valueLbl.Parent = wrap
    local track = Instance.new("Frame")
    track.Position = UDim2.new(0, 12, 0, 34); track.Size = UDim2.new(1, -24, 0, 6)
    track.BackgroundColor3 = Color3.fromRGB(50,50,62); track.BackgroundTransparency = 0.2
    track.BorderSizePixel = 0; track.ZIndex = 7; track.Parent = wrap
    local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(1, 0); tc.Parent = track
    local tp = Instance.new("UIPadding"); tp.PaddingLeft = UDim.new(0, 8); tp.PaddingRight = UDim.new(0, 8); tp.Parent = track
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0); fill.BackgroundColor3 = C_ACCENT
    fill.BorderSizePixel = 0; fill.ZIndex = 8; fill.Parent = track
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(1, 0); fc.Parent = fill
    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5); knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.Size = UDim2.new(0, 16, 0, 16); knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
    knob.BorderSizePixel = 0; knob.ZIndex = 9; knob.Parent = track
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob
    local function formatVal(v)
        if step and step < 1 then return string.format("%.2f", v) end
        return tostring(math.floor(v))
    end
    local function apply(v)
        local ratio = (maxV > minV) and (v - minV) / (maxV - minV) or 0
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        valueLbl.Text = formatVal(v)
    end
    local function setValueFromX(x)
        local absTrack = track.AbsolutePosition
        local absSize = track.AbsoluteSize
        local contentX = absTrack.X + 8
        local contentW = math.max(absSize.X - 16, 1)
        local ratio = math.clamp((x - contentX) / contentW, 0, 1)
        local v = minV + (maxV - minV) * ratio
        if step and step > 0 then v = math.floor(v / step + 0.5) * step end
        v = math.clamp(v, minV, maxV)
        apply(v)
        if onChanged then onChanged(v) end
    end
    apply(default)
    local draggingSlider = false
    local conns = {}
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true; infoScroll.ScrollingEnabled = false
        end
    end)
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            setValueFromX(input.Position.X)
            draggingSlider = true; infoScroll.ScrollingEnabled = false
        end
    end)
    table.insert(conns, UserInput.InputChanged:Connect(function(input)
        if not draggingSlider then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            setValueFromX(input.Position.X)
        end
    end))
    table.insert(conns, UserInput.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if draggingSlider then draggingSlider = false; infoScroll.ScrollingEnabled = true end
        end
    end))
    wrap.Destroying:Connect(function() for _, c in ipairs(conns) do c:Disconnect() end end)
    return wrap
end

local function makeCycle(text, order, options, default, onChanged)
    local row = Instance.new("TextButton")
    row.Size = UDim2.new(1, 0, 0, 40)
    row.BackgroundColor3 = C_ITEM; row.BackgroundTransparency = 0.4
    row.BorderSizePixel = 0; row.AutoButtonColor = false
    row.Text = ""; row.LayoutOrder = order; row.ZIndex = 6; row.Parent = infoScroll
    local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(0, 8); rc.Parent = row
    local rs = Instance.new("UIStroke"); rs.Thickness = 1; rs.Transparency = 0.75; rs.Color = C_STROKE; rs.Parent = row
    local label = Instance.new("TextLabel")
    label.Position = UDim2.new(0, 12, 0, 0); label.Size = UDim2.new(0.5, 0, 1, 0)
    label.BackgroundTransparency = 1; label.Font = Enum.Font.GothamMedium
    label.Text = text; label.TextSize = 14; label.TextColor3 = C_TXT
    label.TextTransparency = 0.1; label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 7; label.Parent = row
    local valueLbl = Instance.new("TextLabel")
    valueLbl.AnchorPoint = Vector2.new(1, 0.5); valueLbl.Position = UDim2.new(1, -12, 0.5, 0)
    valueLbl.Size = UDim2.new(0.5, -12, 1, 0); valueLbl.BackgroundTransparency = 1
    valueLbl.Font = Enum.Font.GothamBold; valueLbl.TextSize = 13
    valueLbl.TextColor3 = C_ACCENT; valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.ZIndex = 7; valueLbl.Parent = row
    local current = default
    local function render() valueLbl.Text = tostring(current) .. "  ▾" end
    render()
    row.MouseEnter:Connect(function() TweenService:Create(row, TweenInfo.new(0.15), { BackgroundColor3 = C_ITEM_HOVER, BackgroundTransparency = 0.25 }):Play() end)
    row.MouseLeave:Connect(function() TweenService:Create(row, TweenInfo.new(0.15), { BackgroundColor3 = C_ITEM, BackgroundTransparency = 0.4 }):Play() end)
    row.MouseButton1Click:Connect(function()
        local idx = 1
        for i, v in ipairs(options) do if v == current then idx = i; break end end
        idx = idx % #options + 1
        current = options[idx]; render()
        if onChanged then onChanged(current) end
    end)
    return row
end

local activeItem = nil
local navItems = {}
local function setActive(item)
    if activeItem == item then return end
    if activeItem then
        TweenService:Create(activeItem, TweenInfo.new(0.18), { BackgroundColor3 = C_ITEM, BackgroundTransparency = 0.4, TextColor3 = C_TXT_DIM, TextTransparency = 0.25 }):Play()
        local s = activeItem:FindFirstChildOfClass("UIStroke"); if s then TweenService:Create(s, TweenInfo.new(0.18), { Transparency = 0.75 }):Play() end
    end
    activeItem = item
    TweenService:Create(item, TweenInfo.new(0.18), { BackgroundColor3 = C_ITEM_ACT, BackgroundTransparency = 0.15, TextColor3 = C_TXT, TextTransparency = 0 }):Play()
    local s = item:FindFirstChildOfClass("UIStroke"); if s then TweenService:Create(s, TweenInfo.new(0.18), { Transparency = 0.45 }):Play() end
end
local function makeNavItem(label, order, onClick)
    local btn = Instance.new("TextButton")
    btn.Name = label; btn.Size = UDim2.new(1, 0, 0, 32)   -- ★ 恢复 32px
    btn.BackgroundColor3 = C_ITEM; btn.BackgroundTransparency = 0.4
    btn.BorderSizePixel = 0; btn.AutoButtonColor = false
    btn.Font = Enum.Font.GothamMedium; btn.Text = "  " .. label
    btn.TextSize = 14; btn.TextColor3 = C_TXT_DIM; btn.TextTransparency = 0.25
    btn.TextXAlignment = Enum.TextXAlignment.Left; btn.LayoutOrder = order
    btn.ZIndex = 6; btn.Parent = navList
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = btn   -- ★ 恢复 8px 圆角
    local s = Instance.new("UIStroke"); s.Thickness = 1; s.Transparency = 0.75; s.Color = C_STROKE; s.Parent = btn
    btn.MouseEnter:Connect(function()
        if activeItem == btn then return end
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C_ITEM_HOVER, BackgroundTransparency = 0.25, TextColor3 = C_TXT, TextTransparency = 0.1 }):Play()
    end)
    btn.MouseLeave:Connect(function()
        if activeItem == btn then return end
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C_ITEM, BackgroundTransparency = 0.4, TextColor3 = C_TXT_DIM, TextTransparency = 0.25 }):Play()
    end)
    btn.MouseButton1Click:Connect(function()
        setActive(btn); if onClick then onClick() end
    end)
    table.insert(navItems, btn)
    return btn
end

