local minimized = false
local animating = false
local activeDrag = nil
local ISLAND_TWEEN = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local CORNER_TWEEN = TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function minimize()
    if minimized or animating then return end
    minimized = true; animating = true
    TweenService:Create(panel, ISLAND_TWEEN, { Position = ISLAND_POS, Size = ISLAND_SIZE, BackgroundTransparency = 0.02 }):Play()
    TweenService:Create(panelCorner, CORNER_TWEEN, { CornerRadius = UDim.new(1, 0) }):Play()
    task.delay(ISLAND_TWEEN.Time, function()
        animating = false
        nav.Visible = false; content.Visible = false
        minBtn.Visible = false; resizeDot.Visible = false; dragBar.Visible = false
    end)
end
local function expand()
    if not minimized or animating then return end
    minimized = false; animating = true
    nav.Visible = true; content.Visible = true
    minBtn.Visible = true; resizeDot.Visible = true; dragBar.Visible = true
    TweenService:Create(panel, ISLAND_TWEEN, { Position = EXPAND_POS, Size = EXPAND_SIZE, BackgroundTransparency = 0.06 }):Play()
    TweenService:Create(panelCorner, CORNER_TWEEN, { CornerRadius = UDim.new(0, 18) }):Play()
    task.delay(ISLAND_TWEEN.Time, function() animating = false end)
end
minBtn.MouseButton1Click:Connect(minimize)
minBtn.MouseEnter:Connect(function() TweenService:Create(minBtn, TweenInfo.new(0.15), { BackgroundTransparency = 0.1 }):Play() end)
minBtn.MouseLeave:Connect(function() TweenService:Create(minBtn, TweenInfo.new(0.15), { BackgroundTransparency = 0.25 }):Play() end)
panel.InputBegan:Connect(function(input)
    if minimized and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then expand() end
end)

local resizing = false
local resizeStartSize, resizeStartMouse
resizeDot.InputBegan:Connect(function(input)
    if minimized or animating or activeDrag ~= nil then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizing = true; activeDrag = "resize"
        resizeStartSize = panel.AbsoluteSize
        resizeStartMouse = UserInput:GetMouseLocation()
        resizeDot.BackgroundTransparency = 0.05
    end
end)
local dragging = false
local dragStartPos, dragStartMouse
dragBar.InputBegan:Connect(function(input)
    if minimized or animating or activeDrag ~= nil then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; activeDrag = "move"
        dragStartPos = panel.Position
        dragStartMouse = UserInput:GetMouseLocation()
        dragBar.BackgroundTransparency = 0.1
    end
end)
UserInput.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local mouse = UserInput:GetMouseLocation()
    if resizing then
        local delta = mouse - resizeStartMouse
        local newX = math.clamp(resizeStartSize.X + delta.X, MIN_SIZE.X, MAX_SIZE.X)
        local newY = math.clamp(resizeStartSize.Y + delta.Y, MIN_SIZE.Y, MAX_SIZE.Y)
        panel.Size = UDim2.fromOffset(newX, newY)
    elseif dragging then
        local delta = mouse - dragStartMouse
        local vp = workspace.CurrentCamera.ViewportSize
        panel.Position = UDim2.new(dragStartPos.X.Scale + delta.X/vp.X, dragStartPos.X.Offset, dragStartPos.Y.Scale + delta.Y/vp.Y, dragStartPos.Y.Offset)
    end
end)
UserInput.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if resizing then resizing = false; activeDrag = nil; resizeDot.BackgroundTransparency = 0.35 end
    if dragging then dragging = false; activeDrag = nil; dragBar.BackgroundTransparency = 0.4 end
end)

